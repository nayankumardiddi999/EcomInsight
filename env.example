APP_NAME=EcomInsights API
APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=sqlite:///./ecominsights.db
CORS_ORIGINS=http://localhost:5173

# Live Google Shopping API Key (Server-side only; never exposed to browser)
# SERPAPI_API_KEY=your_serpapi_key_here

# Configurable Allowlist of Trusted Retailers (comma-separated store codes)
# Default for India: Amazon India and Flipkart only
TRUSTED_RETAILERS=amazon,flipkart
